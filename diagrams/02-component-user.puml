@startuml
!include <C4/C4_Component>

title C4 Component Diagram — User Service

Container_Boundary(userService, "User Service") {
    Component(userApi, "User API", "REST Controller", "Принимает HTTP-запросы на регистрацию, авторизацию, управление профилем, ролями и правами доступа")
    Component(authComponent, "Authentication & Session Component", "Application Service", "Регистрирует и аутентифицирует пользователей, проверяет учётные данные, создаёт и обновляет access- и refresh-токены, завершает пользовательские сессии")
    Component(userProfileComponent, "User Profile Component", "Application Service", "Предоставляет и изменяет данные профиля пользователя: имя, контактные данные, настройки и статус учётной записи")
    Component(roleAccessComponent, "Role & Access Component", "Application Service", "Управляет ролями и правами пользователей, назначает и отзывает роли, проверяет доступ к ресурсам системы")
    Component(userRepository, "User Repository", "Repository", "Инкапсулирует чтение и сохранение пользователей, ролей, прав доступа и сессий")
}

ContainerDb(userDb, "User DB", "PostgreSQL", "Хранит пользователей, профили, роли, права доступа, refresh-токены и активные сессии")
Container(apiGateway, "API Gateway / BFF", "Go", "Единая точка входа для Web и Mobile приложений, маршрутизирующая запросы к микросервисам")

Rel(apiGateway, userApi, "Передаёт запросы управления пользователями", "REST / HTTPS")

Rel(userApi, authComponent, "Передаёт запросы регистрации, входа, обновления токена и выхода")
Rel(userApi, userProfileComponent, "Передаёт запросы чтения и изменения профиля")
Rel(userApi, roleAccessComponent, "Передаёт запросы управления ролями и правами доступа")

Rel(authComponent, userRepository, "Получает пользователя, проверяет учётные данные и сохраняет сессии")
Rel(userProfileComponent, userRepository, "Читает и изменяет данные профиля")
Rel(roleAccessComponent, userRepository, "Читает, назначает и отзывает роли и права")

Rel(userRepository, userDb, "Читает и сохраняет данные", "SQL")

@enduml